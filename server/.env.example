# LearnIQ Backend Server Environment Variables
# Configure these in the Render backend web service environment settings
GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
PORT=3000
NODE_ENV=production
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://learniq.vercel.app,https://learniq-frontend.onrender.com
GEMINI_FILE_PROCESSING_TIMEOUT_MS=300000

# PostgreSQL Database Configuration (REQUIRED in production)
# Example for Render PostgreSQL: postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/dbname
# In development, if DATABASE_URL is unset, the server falls back to local SQLite.
DATABASE_URL=postgresql://learniq_user:password@localhost:5432/learniq

# File Upload Storage (optional persistent directory path)
# In production on Render with a Persistent Disk or local persistent mount:
# LEARNIQ_UPLOADS_DIR=/var/data/uploads

# Session & Cookie settings
# COOKIE_SAMESITE=None
# Optional local SQLite data directory (used only when DATABASE_URL is unset):
# LEARNIQ_DATA_DIR=server/data
