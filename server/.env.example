# LearnIQ Backend Server Environment Variables
# Configure these in the Render backend web service environment settings
GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
PORT=3000
NODE_ENV=production
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://learniq-frontend.onrender.com
GEMINI_FILE_PROCESSING_TIMEOUT_MS=300000
# Optional: LEARNIQ_DATA_DIR=server/data
# Optional: COOKIE_SAMESITE=None
