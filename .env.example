# Backend Environment Variables (configured in Render backend service or server/.env)
GEMINI_API_KEY=your_gemini_api_key_here
QDRANT_URL=your_qdrant_url_here
QDRANT_API_KEY=your_qdrant_api_key_here
PORT=3000
NODE_ENV=production
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://learniq.vercel.app,https://learniq-frontend.onrender.com
GEMINI_FILE_PROCESSING_TIMEOUT_MS=300000

# PostgreSQL Database Configuration (REQUIRED in production)
# Example for Render PostgreSQL: postgresql://user:password@dpg-xxxx.oregon-postgres.render.com/dbname
DATABASE_URL=postgresql://learniq_user:password@localhost:5432/learniq

# File Upload Storage (optional persistent directory path)
# LEARNIQ_UPLOADS_DIR=/var/data/uploads

# Frontend Environment Variable (configured in Vercel / Render frontend static site / build env)
# Note: Vite embeds VITE_ variables at build time. Trigger a new build after setting this.
VITE_API_BASE_URL=https://learniq-your-multimodal-ai-learning.onrender.com
