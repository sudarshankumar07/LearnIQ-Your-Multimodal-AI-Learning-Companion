# LearnIQ Frontend Environment Variables
# In production on Render, set this to your backend service URL (without trailing slash)
# Example: https://learniq-your-multimodal-ai-learning.onrender.com
# In local development, leave empty or unset to use the Vite dev proxy
VITE_API_BASE_URL=https://learniq-your-multimodal-ai-learning.onrender.com

